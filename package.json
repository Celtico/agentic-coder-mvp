{
  "name": "agentic-coder-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop coding agent MVP",
  "main": "src/electron/main.cjs",
  "scripts": {
    "start": "npm run typecheck && npm run build:agent && npm run build:ui && electron .",
    "check": "node --check src/electron/main.cjs && node --check src/electron/preload.cjs && node --check src/electron/git-tools.cjs && node --check src/core/assistant/agent-worker.cjs && npm run typecheck && npm run build:agent && node --check src/core/assistant/agent-runtime.cjs && npm run build:ui",
    "test": "npm run build:agent && node --test",
    "evaluate:memory": "npm run build:agent && node scripts/evaluate-memory.cjs",
    "build:ui": "esbuild src/app/index.tsx --bundle --format=iife --platform=browser --target=chrome130 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=src/app.bundle.js",
    "build:agent": "esbuild src/core/assistant/agent.ts --bundle --format=cjs --platform=node --target=node20 --packages=external --outfile=src/core/assistant/agent-runtime.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@huggingface/transformers": "^4.3.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.9.0",
    "typescript": "^7.0.2"
  }
}
