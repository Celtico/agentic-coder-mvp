{
  "name": "agentic-coder-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop coding agent MVP",
  "homepage": "https://github.com/Celtico/agentic-coder-mvp",
  "repository": { "type": "git", "url": "https://github.com/Celtico/agentic-coder-mvp.git" },
  "main": "src/electron/main.cjs",
  "scripts": {
    "start": "npm run typecheck && npm run build:agent && npm run build:ui && electron .",
    "dist:mac": "npm run check && electron-builder --mac dmg --arm64",
    "dist:linux": "npm run check && electron-builder --linux AppImage deb --x64",
    "check": "node --check src/electron/main.cjs && node --check src/electron/preload.cjs && node --check src/electron/git-tools.cjs && node --check src/core/assistant/agent-worker.cjs && npm run typecheck && npm run build:agent && node --check src/core/assistant/agent-runtime.cjs && npm run build:ui",
    "test": "npm run build:agent && node --test",
    "evaluate:memory": "npm run build:agent && node scripts/evaluate-memory.cjs",
    "evaluate:agent": "npm run build:agent && node scripts/evaluate-agent.cjs",
    "build:ui": "esbuild src/app/index.tsx --bundle --format=iife --platform=browser --target=chrome130 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=src/app.bundle.js",
    "build:agent": "esbuild src/core/assistant/agent.ts --bundle --format=cjs --platform=node --target=node20 --packages=external --outfile=src/core/assistant/agent-runtime.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@huggingface/transformers": "^4.3.1",
    "@monaco-editor/react": "^4.7.0",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "git-interface": "^2.1.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "cat.agentic-coder.mvp",
    "productName": "Agentic Coder",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "package.json",
      "assets/**",
      "src/index.html",
      "src/app.bundle.js",
      "src/app.bundle.css",
      "src/electron/*.cjs",
      "!src/electron/*.test.cjs",
      "src/core/assistant/agent-runtime.cjs",
      "src/core/assistant/agent-worker.cjs",
      "src/core/assistant/*.py",
      "scripts/evaluate-agent.cjs",
      "scripts/agent-benchmark/*.cjs",
      "!scripts/agent-benchmark/*.test.cjs",
      "prompts/**"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "Agentic Coder <agentic-coder@users.noreply.github.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleDevelopmentRegion": "ca",
        "CFBundleLocalizations": ["ca", "es", "en"],
        "NSMicrophoneUsageDescription": "Agentic Coder fa servir el micròfon per al dictat del xat, que es transcriu en aquest Mac."
      }
    },
    "dmg": {
      "title": "Agentic Coder"
    }
  }
}
